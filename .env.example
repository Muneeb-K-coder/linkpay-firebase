DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Put the path to your Firebase service-account JSON here. Keep this file private.
FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json
# Firebase web config is public app configuration; fill these in templates/dashboard.html.
